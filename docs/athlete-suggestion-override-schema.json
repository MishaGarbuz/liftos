{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auxos.app/schemas/athlete-suggestion-override.json",
  "title": "Auxos Athlete Suggestion Override",
  "type": "object",
  "additionalProperties": false,
  "required": ["sets"],
  "properties": {
    "targetExerciseName": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "updatedAt": { "type": "string" },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setNumber"],
        "properties": {
          "setNumber": { "type": "integer", "minimum": 1 },
          "weightKg": { "type": "number", "minimum": 0 },
          "repsTarget": { "type": "string", "minLength": 1 },
          "targetReps": { "type": "integer", "minimum": 1 },
          "rpeTarget": { "type": "number", "minimum": 1, "maximum": 10 },
          "restSec": { "type": "integer", "minimum": 0 },
          "lockedByAthlete": { "type": "boolean" }
        }
      }
    }
  }
}
