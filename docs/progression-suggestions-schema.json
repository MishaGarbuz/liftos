{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auxos.app/schemas/progression-suggestions/v1.json",
  "title": "AuxosProgressionSuggestions",
  "description": "Structured next-week training suggestions generated by the AI Coach. One object per target week, keyed by workout slot.",
  "type": "object",
  "required": [
    "schemaVersion",
    "task",
    "targetWeek",
    "coachPolicyVersion",
    "slots"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "task": { "type": "string", "const": "progression_suggestions" },
    "coachPolicyVersion": { "type": "string", "minLength": 1 },
    "targetWeek": { "type": "integer", "minimum": 1, "maximum": 52 },
    "phaseLabel": { "type": "string" },
    "isDeloadWeek": { "type": "boolean" },
    "athleteMessage": {
      "type": "string",
      "description": "Short athlete-facing summary; keep concise."
    },
    "slots": {
      "type": "object",
      "description": "Map of slotId -> suggestion",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/slotSuggestion" }
    }
  },
  "$defs": {
    "slotSuggestion": {
      "type": "object",
      "required": [
        "slotId",
        "day",
        "plannedExerciseName",
        "targetExerciseName",
        "loadScheme",
        "decision",
        "sets"
      ],
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "day": {
          "type": "string",
          "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
        },
        "plannedExerciseName": { "type": "string", "minLength": 1 },
        "targetExerciseName": { "type": "string", "minLength": 1 },
        "loadScheme": {
          "type": "string",
          "enum": [
            "barbell_total",
            "dumbbell_pair_total",
            "dumbbell_single",
            "cable_stack",
            "machine_load",
            "bodyweight",
            "assistance_load",
            "timed_hold",
            "other"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "increase_load",
            "increase_reps",
            "hold",
            "decrease_load",
            "deload",
            "fallback_baseline",
            "override_preserved"
          ]
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "top_of_range_low_rpe",
            "completed_at_target",
            "high_rpe_hold",
            "missed_reps",
            "missed_sets",
            "fatigue_signal",
            "load_type_changed",
            "deload_week",
            "insufficient_data",
            "manual_override",
            "coach_discretion"
          ]
        },
        "note": {
          "type": "string",
          "description": "Short rationale for this slot."
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setSuggestion" }
        }
      }
    },
    "setSuggestion": {
      "type": "object",
      "required": ["setNumber"],
      "properties": {
        "setNumber": { "type": "integer", "minimum": 1 },
        "weightKg": {
          "type": "number",
          "minimum": 0,
          "description": "Total prescribed load in kg using the slot loadScheme."
        },
        "repsTarget": {
          "type": "string",
          "description": "Human-readable target, e.g. 8-10 or 30s."
        },
        "targetReps": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional single-number rep target when the app wants a specific suggestion."
        },
        "rpeTarget": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "restSec": {
          "type": "integer",
          "minimum": 0
        },
        "lockedByAthlete": {
          "type": "boolean",
          "description": "True if this suggestion preserves an athlete-locked value."
        },
        "note": {
          "type": "string",
          "description": "Short set-specific note."
        }
      }
    }
  }
}
